# Copia este ficheiro para .env.local e ajusta conforme precisares.
# O .env.local não vai para o git (cada máquina tem o seu).

# Rede local sem HTTPS (aceder pelo IP do PC no telemóvel)?
# Põe 1 para o cookie de sessão funcionar por HTTP simples.
# Num domínio com HTTPS, deixa a 0 (ou apaga a linha) — é mais seguro.
COOKIE_INSEGURO=0
